// {{.ClassName}}Query {{.FunctionName}}查询条件
type {{.ClassName}}Query struct {
	PageNum  int
	PageSize int
{{- range .Fields}}
{{- if .IsQuery}}
	{{.GoField}} {{.GoType}} // {{.Comment}}
{{- end}}
{{- end}}
}

// List{{.ClassName}} 分页查询{{.FunctionName}}
func List{{.ClassName}}(q {{.ClassName}}Query) ([]model.{{.ClassName}}, int64, error) {
	var list []model.{{.ClassName}}
	db := DB.Model(&model.{{.ClassName}}{})
{{- range .Fields}}
{{- if .IsQuery}}
	// {{.Comment}}
{{- if eq .GoType "string"}}
{{- if eq .QueryType "LIKE"}}
	if q.{{.GoField}} != "" {
		db = db.Where(likeExprEsc("{{.ColumnName}}"), "%"+escapeLike(q.{{.GoField}})+"%")
	}
{{- else}}
	if q.{{.GoField}} != "" {
		db = db.Where("{{.ColumnName}} {{if eq .QueryType "EQ"}}= {{else}}{{.QueryType}} {{end}}?", q.{{.GoField}})
	}
{{- end}}
{{- else}}
	if q.{{.GoField}} != 0 {
		db = db.Where("{{.ColumnName}} {{if eq .QueryType "EQ"}}= {{else}}{{.QueryType}} {{end}}?", q.{{.GoField}})
	}
{{- end}}
{{- end}}
{{- end}}
{{- if .IsTree}}
	// 树形表一次取全量，由前端按 children 渲染层级（不分页）
	if err := db.Order("{{.TreeCode}} asc, {{.IDJsonField}} asc").Find(&list).Error; err != nil {
		return nil, 0, err
	}
	return build{{.ClassName}}Tree(list, 0, 0), int64(len(list)), nil
{{- else}}
	var total int64
	if err := db.Count(&total).Error; err != nil {
		return nil, 0, err
	}
	err := db.Order("{{.IDJsonField}} asc").Offset((q.PageNum - 1) * q.PageSize).Limit(q.PageSize).Find(&list).Error
	return list, total, err
{{- end}}
}

// List{{.ClassName}}All 不分页查询{{.FunctionName}}（Excel 导出使用）
func List{{.ClassName}}All(q {{.ClassName}}Query) ([]model.{{.ClassName}}, error) {
	var list []model.{{.ClassName}}
	db := DB.Model(&model.{{.ClassName}}{})
{{- range .Fields}}
{{- if .IsQuery}}
	// {{.Comment}}
{{- if eq .GoType "string"}}
{{- if eq .QueryType "LIKE"}}
	if q.{{.GoField}} != "" {
		db = db.Where(likeExprEsc("{{.ColumnName}}"), "%"+escapeLike(q.{{.GoField}})+"%")
	}
{{- else}}
	if q.{{.GoField}} != "" {
		db = db.Where("{{.ColumnName}} {{if eq .QueryType "EQ"}}= {{else}}{{.QueryType}} {{end}}?", q.{{.GoField}})
	}
{{- end}}
{{- else}}
	if q.{{.GoField}} != 0 {
		db = db.Where("{{.ColumnName}} {{if eq .QueryType "EQ"}}= {{else}}{{.QueryType}} {{end}}?", q.{{.GoField}})
	}
{{- end}}
{{- end}}
{{- end}}
	if err := db.Order("{{.IDJsonField}} asc").Find(&list).Error; err != nil {
		return nil, err
	}
{{- if .IsSub}}
	// 主子表导出需要带上子表明细
	for i := range list {
		var children []model.{{.SubClassName}}
		if err := DB.Where("{{.SubFkColumn}} = ?", list[i].{{.IDField}}).Order("{{.SubIDJsonField}} asc").Find(&children).Error; err != nil {
			return nil, err
		}
		list[i].Children = children
	}
{{- end}}
	return list, nil
}
{{- if .IsTree}}

// build{{.ClassName}}Tree 按父级字段把平铺数据组装成树
func build{{.ClassName}}Tree(list []model.{{.ClassName}}, parent {{.IDGoType}}, depth int) []model.{{.ClassName}} {
	nodes := make([]model.{{.ClassName}}, 0)
	// 防止脏数据把父级指成环导致无限递归
	if depth > 50 {
		return nodes
	}
	for i := range list {
		if list[i].{{.TreeParentGoField}} == parent {
			list[i].Children = build{{.ClassName}}Tree(list, list[i].{{.IDField}}, depth+1)
			nodes = append(nodes, list[i])
		}
	}
	return nodes
}
{{- end}}

// Get{{.ClassName}} 按 ID 查询{{.FunctionName}}
func Get{{.ClassName}}(id uint) (*model.{{.ClassName}}, error) {
	var item model.{{.ClassName}}
	err := DB.First(&item, id).Error
{{- if .IsSub}}
	if err != nil {
		return &item, err
	}
	var children []model.{{.SubClassName}}
	if err := DB.Where("{{.SubFkColumn}} = ?", id).Order("{{.SubIDJsonField}} asc").Find(&children).Error; err != nil {
		return &item, err
	}
	item.Children = children
{{- end}}
	return &item, err
}

// {{.ClassName}}Req {{.FunctionName}}请求体
type {{.ClassName}}Req struct {
{{- range .Fields}}
	{{.GoField}} {{.GoType}} `json:"{{.JsonField}}" excel:"{{if .Comment}}{{.Comment}}{{else}}{{.GoField}}{{end}}"`{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
{{- if .IsSub}}
	Children []{{.SubClassName}}Req `json:"children" excel:"-"` // 子表数据（Excel 导入来自明细工作表）
