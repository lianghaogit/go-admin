// {{.SubClassName}}Req {{.SubTableComment}}请求体
type {{.SubClassName}}Req struct {
{{- range .SubFields}}
{{- if or .IsPk (eq .ColumnName $.SubFkColumn)}}
	{{.GoField}} {{.GoType}} `json:"{{.JsonField}}" excel:"-"`{{if .Comment}} // {{.Comment}}{{end}}
{{- else}}
	{{.GoField}} {{.GoType}} `json:"{{.JsonField}}" excel:"{{if .Comment}}{{.Comment}}{{else}}{{.GoField}}{{end}}"`{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
{{- end}}
}
{{- end}}

// Create{{.ClassName}} 新增{{.FunctionName}}
func Create{{.ClassName}}(r {{.ClassName}}Req) error {
{{- if .IsSub}}
	return DB.Transaction(func(tx *gorm.DB) error {
		item := model.{{.ClassName}}{
{{- range .Fields}}
{{- if not .IsPk}}
			{{.GoField}}: r.{{.GoField}},
{{- end}}
{{- end}}
		}
{{- range .Fields}}
{{- if .IsCreateTime}}
		if item.{{.GoField}}.Time().IsZero() {
			item.{{.GoField}} = model.LocalTime(time.Now())
		}
{{- end}}
{{- if .IsUpdateTime}}
		if item.{{.GoField}}.Time().IsZero() {
			item.{{.GoField}} = model.LocalTime(time.Now())
		}
{{- end}}
{{- end}}
		if err := tx.Create(&item).Error; err != nil {
			return err
		}
		// 子表随主表一起写入（外键关系由程序维护，数据库不建物理外键）
		for _, c := range r.Children {
			child := model.{{.SubClassName}}{
{{- range .SubFields}}
{{- if and (not .IsPk) (ne .ColumnName $.SubFkColumn)}}
				{{.GoField}}: c.{{.GoField}},
{{- end}}
{{- end}}
				{{.SubFkGoField}}: item.{{.IDField}},
			}
{{- range .SubFields}}
{{- if .IsCreateTime}}
			if child.{{.GoField}}.Time().IsZero() {
				child.{{.GoField}} = model.LocalTime(time.Now())
			}
{{- end}}
{{- end}}
			if err := tx.Create(&child).Error; err != nil {
				return err
			}
		}
		return nil
	})
{{- else}}
	item := model.{{.ClassName}}{
{{- range .Fields}}
{{- if not .IsPk}}
		{{.GoField}}: r.{{.GoField}},
{{- end}}
{{- end}}
	}
{{- range .Fields}}
{{- if .IsCreateTime}}
	if item.{{.GoField}}.Time().IsZero() {
		item.{{.GoField}} = model.LocalTime(time.Now())
	}
{{- end}}
{{- if .IsUpdateTime}}
	if item.{{.GoField}}.Time().IsZero() {
		item.{{.GoField}} = model.LocalTime(time.Now())
	}
{{- end}}
{{- end}}
	return DB.Create(&item).Error
{{- end}}
}

// Update{{.ClassName}} 修改{{.FunctionName}}
func Update{{.ClassName}}(r {{.ClassName}}Req, replaceChildren ...bool) error {
{{- if .IsSub}}
	// replaceChildren 仅主子表生效：页面编辑不传时默认全量替换；
	// 导入未提供该主表明细行时传 false，保留原有明细，避免误删。
	replace := true
	if len(replaceChildren) > 0 {
		replace = replaceChildren[0]
	}
{{- end}}
{{- if .IsTree}}
	// 父级不能指向自己或自己的下级，否则构树会成环
	if r.{{.TreeParentGoField}} == r.{{.IDField}} {
		return fmt.Errorf("上级节点不能是自己")
	}
	parentID := r.{{.TreeParentGoField}}
	for depth := 0; parentID != 0 && depth < 50; depth++ {
		if parentID == r.{{.IDField}} {
			return fmt.Errorf("上级节点不能是自身或其下级")
		}
		var parent model.{{.ClassName}}
		if err := DB.Select("{{.TreeParent}}").First(&parent, parentID).Error; err != nil {
			break
		}
		parentID = parent.{{.TreeParentGoField}}
	}
{{- end}}
{{- range .Fields}}
{{- if .IsUpdateTime}}
	if r.{{.GoField}}.Time().IsZero() {
		r.{{.GoField}} = model.LocalTime(time.Now())
	}
{{- end}}
{{- end}}
	updates := map[string]interface{}{
{{- range .Fields}}
{{- if and (not .IsPk) (not .IsCreateTime)}}
		"{{.ColumnName}}": r.{{.GoField}},
{{- end}}
{{- end}}
	}
{{- if .IsSub}}
	return DB.Transaction(func(tx *gorm.DB) error {
		if err := tx.Model(&model.{{.ClassName}}{}).Where("{{.IDJsonField}} = ?", r.{{.IDField}}).Updates(updates).Error; err != nil {
			return err
		}
		// 页面编辑按全量替换子表；导入未带明细时 replace=false，只更新主表字段
		if replace {
			if err := tx.Where("{{.SubFkColumn}} = ?", r.{{.IDField}}).Delete(&model.{{.SubClassName}}{}).Error; err != nil {
				return err
			}
			for _, c := range r.Children {
				child := model.{{.SubClassName}}{
{{- range .SubFields}}
{{- if and (not .IsPk) (ne .ColumnName $.SubFkColumn)}}
					{{.GoField}}: c.{{.GoField}},
{{- end}}
{{- end}}
					{{.SubFkGoField}}: r.{{.IDField}},
				}
{{- range .SubFields}}
{{- if .IsCreateTime}}
				if child.{{.GoField}}.Time().IsZero() {
					child.{{.GoField}} = model.LocalTime(time.Now())
				}
{{- end}}
{{- end}}
				if err := tx.Create(&child).Error; err != nil {
					return err
				}
			}
		}
		return nil
	})
{{- else}}
	return DB.Model(&model.{{.ClassName}}{}).Where("{{.IDJsonField}} = ?", r.{{.IDField}}).Updates(updates).Error
{{- end}}
}

// Delete{{.ClassName}} 删除{{.FunctionName}}
func Delete{{.ClassName}}(id uint) error {
{{- if .IsTree}}
	var children int64
	if err := DB.Model(&model.{{.ClassName}}{}).Where("{{.TreeParent}} = ?", id).Count(&children).Error; err != nil {
		return err
	}
	if children > 0 {
		return fmt.Errorf("存在下级节点，请先删除下级")
	}
	return DB.Delete(&model.{{.ClassName}}{}, id).Error
{{- else if .IsSub}}
	return DB.Transaction(func(tx *gorm.DB) error {
		// 先删子表数据，再删主表（外键关系由程序维护）
		if err := tx.Where("{{.SubFkColumn}} = ?", id).Delete(&model.{{.SubClassName}}{}).Error; err != nil {
			return err
		}
		return tx.Delete(&model.{{.ClassName}}{}, id).Error
	})
{{- else}}
	return DB.Delete(&model.{{.ClassName}}{}, id).Error
{{- end}}
}

