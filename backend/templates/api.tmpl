// List{{.ClassName}} 查询{{.FunctionName}}
func List{{.ClassName}}(c *gin.Context) {
	q := dao.{{.ClassName}}Query{
		PageNum:  pageNum(c),
		PageSize: pageSize(c),
{{- range .Fields}}
{{- if .IsQuery}}
{{- if eq .GoType "string"}}
		{{.GoField}}: c.Query("{{.JsonField}}"),
{{- else if eq .GoType "float64"}}
		{{.GoField}}: mustFloat64(c.Query("{{.JsonField}}")),
{{- else}}
		{{.GoField}}: mustInt64(c.Query("{{.JsonField}}")),
{{- end}}
{{- end}}
{{- end}}
	}
{{- if .IsTree}}
	list, _, err := dao.List{{.ClassName}}(q)
{{- else}}
	list, total, err := dao.List{{.ClassName}}(q)
{{- end}}
	if err != nil {
		utils.Fail(c, 500, "查询失败")
		return
	}
{{- if .IsTree}}
	// 树形数据：返回带 children 的层级结构
	utils.OkData(c, list)
{{- else}}
	utils.OkTable(c, list, total)
{{- end}}
}

// Get{{.ClassName}} 查询{{.FunctionName}}详情
func Get{{.ClassName}}(c *gin.Context) {
	item, err := dao.Get{{.ClassName}}(idParam(c))
	if err != nil {
		utils.Fail(c, 500, "{{.FunctionName}}不存在")
		return
	}
	utils.OkData(c, item)
}

